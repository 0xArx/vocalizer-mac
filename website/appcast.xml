    <item>
      <title>Vocalizer 0.3.7</title>
      <sparkle:version>22</sparkle:version>
      <sparkle:shortVersionString>0.3.7</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.2</sparkle:minimumSystemVersion>
      <pubDate>Tue, 20 Oct 2026 05:52:59 GMT</pubDate>
      <description><![CDATA[
        <ul>
          <li>Updates now ask first: when there&#x27;s a new version, a note appears in the menu and nothing installs until you choose</li>
          <li>Prefer the old way? Settings › Install updates automatically</li>
          <li>Clearer security notes: only the maintainer can publish updates, and every update is signature-checked</li>
        </ul>
      ]]></description>
      <enclosure url="https://github.com/0xArx/vocalizer-mac/releases/download/v0.3.7/Vocalizer-macOS.zip" sparkle:edSignature="/a6IsmfXH44c1BBU0KqNVG35//YSPAokXa3gTrh/cfMegrfSi1F17JoeuQHnU0JFUtknvWEXPjBYxfVMk3QyCA==" length="111200338" type="application/octet-stream"/>
    </item>
    <item>
      <title>Vocalizer 0.3.6</title>
      <sparkle:version>21</sparkle:version>
      <sparkle:shortVersionString>0.3.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.2</sparkle:minimumSystemVersion>
      <pubDate>Mon, 19 Oct 2026 14:53:53 GMT</pubDate>
      <description><![CDATA[
        <ul>
          <li>Speech mode is now called Calls: the lowest delay, for calls and games</li>
          <li>Fast sounds cleaner for videos and talks (measured: about 6 dB cleaner than Calls on talking over music)</li>
        </ul>
      ]]></description>
      <enclosure url="https://github.com/0xArx/vocalizer-mac/releases/download/v0.3.6/Vocalizer-macOS.zip" sparkle:edSignature="2fe3Jeaxej+fi1QJ3M/RFLjTURMkEPWUE7NxmalEfNvuujKfVGFJ8Qckgy3ekxHTNbP6Lda5Fov53xGft+5MDA==" length="111197665" type="application/octet-stream"/>
    </item>
    <item>
      <title>Vocalizer 0.3.5</title>
      <sparkle:version>20</sparkle:version>
      <sparkle:shortVersionString>0.3.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.2</sparkle:minimumSystemVersion>
      <pubDate>Mon, 19 Oct 2026 13:29:53 GMT</pubDate>
      <description><![CDATA[
        <ul>
          <li>Vocalizer now updates itself: new versions download in the background and install when nothing is playing</li>
          <li>Every update is checked against Vocalizer&#x27;s signature and Apple Developer ID before it installs</li>
          <li>New: Install updates automatically in Settings, and Check for Updates when you right-click the menu bar icon</li>
        </ul>
      ]]></description>
      <enclosure url="https://github.com/0xArx/vocalizer-mac/releases/download/v0.3.5/Vocalizer-macOS.zip" sparkle:edSignature="jeyoO7sYeFPwBp7ouLeKxeD/wfw7jdiux35etPuzMgyz4jmxze1dzmDWpfObPa118BnCEQLRykLHpoLbEz33CA==" length="111197617" type="application/octet-stream"/>
